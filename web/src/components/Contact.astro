<section id="contact" class="wrap contact">
  <h2>Let's build something that holds up in production.</h2>
  <p class="open">I'm open to principal and staff roles in data science, ML engineering and applied AI.</p>
  <div class="links">
    <a href="mailto:salaheddineaitdaoud@gmail.com" class="btn btn-primary">Email me</a>
    <a href="https://linkedin.com/in/salah-ad" class="btn">LinkedIn</a>
    <a href="https://github.com/SalaheddineAD" class="btn">GitHub</a>
  </div>
  <!-- mailto does nothing without a mail app, so the address is also shown and copyable. -->
  <p class="address">
    <span>salaheddineaitdaoud@gmail.com</span>
    <button type="button" class="copy" data-copy="salaheddineaitdaoud@gmail.com">Copy</button>
    <span class="visually-hidden" role="status" data-copy-status></span>
  </p>
</section>
<footer class="wrap footer">
  <p>© 2026 Salah Eddine Ait Daoud</p>
</footer>

<style>
  .contact {
    padding-top: 104px;
    text-align: center;
  }

  h2 {
    margin: 0 auto;
    max-width: 760px;
    font-family: var(--serif);
    font-size: 52px;
    line-height: 1.1;
    font-weight: 500;
  }

  .open { margin: 18px 0 0; font-size: 18px; color: var(--muted); }

  .links {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .links .btn { min-height: 50px; font-size: 16px; padding: 0 22px; }
  .links .btn-primary { padding: 0 26px; }

  .address {
    margin: 20px 0 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 10px;
    font-size: 16px;
    color: var(--muted);
  }

  .copy {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .copy:hover { background: var(--soft); }

  .footer {
    padding-top: 80px;
    padding-bottom: 64px;
    text-align: center;
  }

  .footer p { margin: 0; font-size: 14px; color: var(--muted); }

  @media (max-width: 600px) {
    .contact { padding-top: 80px; }
    h2 { font-size: 38px; }
    .open { font-size: 17px; }
    .footer { padding-top: 64px; padding-bottom: 48px; }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy]')!;
  const status = document.querySelector<HTMLElement>('[data-copy-status]')!;

  button.addEventListener('click', async () => {
    const address = button.dataset.copy!;
    try {
      await navigator.clipboard.writeText(address);
      button.textContent = 'Copied';
      status.textContent = 'Email address copied';
    } catch {
      // Clipboard blocked: select the address so it can be copied by hand.
      const range = document.createRange();
      range.selectNodeContents(button.previousElementSibling!);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(range);
      status.textContent = 'Email address selected';
    }
    window.setTimeout(() => { button.textContent = 'Copy'; status.textContent = ''; }, 2000);
  });
</script>
