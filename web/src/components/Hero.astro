---
import HeroMountains from './HeroMountains.astro';
---

<section id="top" class="hero">
  <HeroMountains />
  <div class="wrap content">
    <h1>Salah Eddine Ait Daoud</h1>
    <p class="title">Principal Data Scientist &amp; Machine Learning Engineer</p>
    <p class="line">I build forecasting, optimization and AI systems that companies run real decisions on. Based in Dallas, Texas.</p>
    <div class="actions">
      <a href="#projects" class="btn btn-primary">See my projects</a>
      <a href="#contact" class="btn btn-glass">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 640px;
    overflow: hidden;
  }

  .content {
    position: relative;
    z-index: 2;
    padding-top: 170px;
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: 76px;
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .title {
    margin: 18px 0 0;
    font-size: 20px;
    font-weight: 500;
  }

  .line {
    margin: 14px 0 0;
    max-width: 560px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }

  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 600px) {
    .content { padding-top: 140px; }
    h1 { font-size: 48px; }
    .title { font-size: 18px; }
    .line { font-size: 17px; }
  }
</style>
