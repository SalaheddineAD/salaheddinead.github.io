---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="wrap bar">
    <nav aria-label="Main">
      <a href="#projects">Projects</a>
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#contact">Contact</a>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 3;
  }

  .bar {
    padding-top: 24px;
    padding-bottom: 24px;
    display: flex;
    gap: 26px;
    align-items: center;
    justify-content: flex-end;
  }

  nav {
    display: flex;
    gap: 26px;
    align-items: center;
    font-size: 15px;
  }

  nav a { text-decoration: none; }

  /* Phones: links on the left, toggle on the right, one row. */
  @media (max-width: 600px) {
    .bar { padding-top: 12px; padding-bottom: 12px; justify-content: space-between; gap: 8px; }
    nav { gap: 0; margin-left: -8px; }
    nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 8px; }
  }

  @media (max-width: 360px) {
    nav a { padding: 0 6px; font-size: 14px; }
  }
</style>
